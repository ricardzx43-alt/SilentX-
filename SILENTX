    end
end)

local Validating = false
VerifyBtn.MouseButton1Click:Connect(function()
    if Validating then return end
    Validating = true
    
    PlaySound(ClickSoundID, 0.5)
    local userKey = KeyTextBox.Text
    
    if userKey == "" then
        PlaySound(ErrorSoundID, 0.5)
        StatusLabel.Text = "Por favor ingresa tu Key."
        StatusLabel.TextColor3 = Colors.Error
        Validating = false
        return
    end

    StatusLabel.Text = "Verificando..."
    StatusLabel.TextColor3 = Colors.TextSecondary

    task.spawn(function()
        local result = PUSL.validate(userKey)
        if result and result.success then
            PlaySound(SuccessSoundID, 0.6)
            StatusLabel.Text = "¡Autenticación Exitosa!"
            StatusLabel.TextColor3 = Colors.Success
            task.wait(1.2)
            ScreenGui:Destroy()
            
            -- Llama a la carga remota de la GUI de optimización
            LoadMainScript()
        else
            PlaySound(ErrorSoundID, 0.5)
            StatusLabel.Text = "Key inválida o expirada."
            StatusLabel.TextColor3 = Colors.Error
            Validating = false
        end
    end)
end)
