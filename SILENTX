local function PlaySound(soundId, volume)
    task.spawn(function()
        local sound = Instance.new("Sound")
        sound.SoundId = soundId
        sound.Volume = volume or 0.5
        sound.Parent = SoundService
        sound:Play()
        sound.Ended:Connect(function()
            sound:Destroy()
        end)
    end)
end

-- FUNCIÓN PARA CARGAR LA GUI DE OPTIMIZACIÓN DESDE GITHUB
local function LoadMainScript()
    print("[SilentX Hub] Key verificada. Cargando GUI de SilentX")
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "SilentX Hub",
        Text = "Cargando interfaz de SilentX",
        Duration = 5
    })
    
    local success, err = pcall(function()
        loadstring(game:HttpGet(OPTIMIZER_URL))()
    end)

    if not success then
        warn("[SilentX Hub] Error al cargar desde GitHub: ", err)
    end
end

