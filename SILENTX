-- 4. EFECTO VISUAL DE NIEVE
-- ==========================================================
local Flakes = {}
local MaxFlakes = 20

for i = 1, MaxFlakes do
    local flake = Instance.new("Frame")
    flake.Name = "Flake"
    flake.Parent = SnowContainer
    flake.BackgroundColor3 = Color3.fromRGB(220, 248, 255)
    flake.BorderSizePixel = 0
    flake.ZIndex = 1
    
    local size = math.random(2, 4)
    flake.Size = UDim2.new(0, size, 0, size)
    
    local flakeCorner = Instance.new("UICorner")
    flakeCorner.CornerRadius = UDim.new(1, 0)
    flakeCorner.Parent = flake
    
    local startX = math.random(10, 380)
    local startY = math.random(-290, 0)
    flake.Position = UDim2.new(0, startX, 0, startY)
    
    table.insert(Flakes, {
        Frame = flake,
        Speed = math.random(25, 55),
        BaseX = startX,
        OffsetY = startY,
        Seed = math.random(1, 100)
    })
end

local snowConnection
snowConnection = RunService.RenderStepped:Connect(function(dt)
    if not MainFrame or not MainFrame.Parent then
        snowConnection:Disconnect()
        return
    end
    
    for _, data in ipairs(Flakes) do
        data.OffsetY = data.OffsetY + (data.Speed * dt)
        local swayX = data.BaseX + math.sin(tick() * 2 + data.Seed) * 10
        
        data.Frame.Position = UDim2.new(0, swayX, 0, data.OffsetY)
        
        if data.OffsetY >= 290 then
            data.OffsetY = -10
            data.BaseX = math.random(10, 380)
        end
    end
end)

